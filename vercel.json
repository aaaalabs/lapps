{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/:slug",
      "has": [
        {
          "type": "host",
          "value": ".*"
        }
      ],
      "destination": "/api/tool?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/speedconnect-demo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "x-robots-tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "public": [
    {
      "source": "/speedconnect-demo/**"
    },
    {
      "source": "/api/speedconnect/**"
    }
  ]
}