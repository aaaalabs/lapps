{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(?!speedconnect-demo|demo|public)([^/]+)/?$",
      "destination": "/api/tool?slug=$1"
    }
  ],
  "headers": [
    {
      "source": "/speedconnect-demo/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}