{
  "rewrites": [
    {
      "source": "/speedconnect-demo/(.*)",
      "destination": "/public/speedconnect-demo/$1"
    },
    {
      "source": "/speedconnect-demo",
      "destination": "/public/speedconnect-demo/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/demo/(.*)",
      "destination": "/public/demo/$1"
    },
    {
      "source": "/public/(.*)",
      "destination": "/public/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/tool?slug=$1"
    }
  ]
}